# 본 파일은 로컬 환경변수의 공개값을 관리합니다.

source_env_if_exists .envrc.local

# API

export API_URL=http://localhost:8080
# 발급처 : 수동 발급
# 의존성 : @bconnect/api-client
# 설명 : 서버 사이드 API 서버 주소

# Google Analytics

# export NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# 발급처 : [Google Tag Manager](https://tagmanager.google.com/)
# 설명 : GA4 태그 ID
