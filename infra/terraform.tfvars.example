# 본 파일은 테라폼 환경변수의 비밀값 템플릿을 관리합니다.
# terraform.tfvars 로 복사해 값을 채워주세요.

# Vercel

vercel_token = "your-vercel-token"
# 발급처 : [Vercel : Account Tokens](https://vercel.com/account/settings/tokens)
# 설명 : Vercel 프로바이더 인증 토큰

# 원클릭 조회

data_go_service_key = "your-data-go-kr-service-key"
# 발급처 : [공공데이터포털 : 마이페이지 인증키](https://www.data.go.kr)
# 설명 : 공공데이터 조회 서비스 키

database_url = "postgresql://user:password@host:port/dbname"
# 발급처 : [Railway : postgres](https://railway.com/project/90cd6d09-4c7b-415f-b13f-3d6b6051769a/service/1b00b504-e28e-4a58-a78c-dfbaba713fbc)
# 설명 : 원클릭 적재 DB TCP 프록시 URL (현재 prod)

# Sentry

sentry_auth_token = "your-sentry-auth-token"
# 발급처 : [Sentry : Auth Tokens](https://sentry.io/settings/auth-tokens/)
# 설명 : Sentry 소스맵 · 소스 컨텍스트 업로드 토큰

# Firebase

fcm_credential = "your-fcm-service-account-json"
# 발급처 : [GCP : 서비스 계정](https://console.cloud.google.com/iam-admin/serviceaccounts)
# 설명 : FCM HTTP v1 서비스 계정 키 JSON

# GitHub Actions

figma_access_token = "your-figma-access-token"
# 발급처 : [Figma : Personal access tokens](https://www.figma.com/developers/api#access-tokens)
# 설명 : Figma API 액세스 토큰

slack_webhook_url = "https://hooks.slack.com/services/your-webhook"
# 발급처 : [Slack : Incoming Webhooks](https://api.slack.com/messaging/webhooks)
# 설명 : Slack 모니터링 알림 웹훅 URL
