{
  "name": "morton",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky && sh scripts/link-env.sh",
    "dev": "pnpm -r --parallel dev",
    "dev:career": "pnpm --filter @bconnect/career dev",
    "dev:plan": "pnpm --filter @bconnect/plan dev",
    "dev:company": "pnpm --filter @bconnect/company dev",
    "build": "pnpm -r --stream build",
    "build:career": "pnpm --filter @bconnect/career build",
    "build:plan": "pnpm --filter @bconnect/plan build",
    "build:company": "pnpm --filter @bconnect/company build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && prettier --check . && terraform fmt -check -recursive",
    "lint:fix": "eslint --fix && prettier --write . && terraform fmt -recursive",
    "lint:docs": "markdownlint-cli2 && lychee \"**/*.md\"",
    "lint:docs:fix": "markdownlint-cli2 --fix",
    "api:generate": "pnpm --filter @bconnect/api-client generate && pnpm typecheck",
    "figma": "node scripts/figma-mapping/index.ts",
    "figma:dry": "node scripts/figma-mapping/index.ts --dry-run",
    "secret:check": "sh scripts/check-env.sh"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.63.0",
    "postgres": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "3.11.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "!(*.js|*.jsx|*.ts|*.tsx|*.md|*.mdx|*.tf|*.tfvars|*.tftest.hcl)": [
      "prettier --write --ignore-unknown"
    ],
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,mdx}": [
      "prettier --write",
      "markdownlint-cli2 --fix --no-globs",
      "lychee"
    ],
    "*.{tf,tfvars,tftest.hcl}": [
      "terraform fmt -recursive"
    ]
  }
}
