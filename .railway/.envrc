# 본 파일은 로컬 환경변수의 공개값을 관리합니다.

source_env_if_exists .envrc.local

# Railway ctx.environment에 따라 *_DEV 또는 *_PROD만 사용합니다.
# 빈 값은 실제 설정을 작성해야 하며, 선택한 환경의 값이 없으면 plan/apply가 실패합니다.

# dev / GitHub dev

# JVM

export JAVA_TOOL_OPTIONS_DEV='-XX:-UseContainerSupport'
# 발급처 : 수동 작성
# 설명 : JVM 컨테이너 한도 대신 호스트 자원을 기준으로 판단

# AWS

export AWS_REGION_DEV='ap-northeast-2'
# 발급처 : infra/variables.tf aws_region
# 의존성 : apps/api
# 설명 : AWS 기본 리전

export AWS_S3_BUCKET_DEV='bconnect-storage-dev'
# 발급처 : AWS S3 콘솔
# 의존성 : apps/api
# 설명 : 파일 업로드 대상 버킷 이름

export AWS_SNS_PLATFORM_ARN_DEV='arn:aws:sns:ap-northeast-2:214572253021:app/GCM/bconnect-fcm'
# 발급처 : AWS SNS 콘솔
# 의존성 : apps/api
# 설명 : SNS 플랫폼 애플리케이션 ARN

# Solapi

export SOLAPI_SENDER_NUMBER_DEV='01083358632'
# 발급처 : Solapi 콘솔의 등록 발신번호
# 의존성 : apps/api
# 설명 : 문자 발송용 등록 발신번호

# Sentry

export SENTRY_DSN_DEV='https://ecedbe1f879f8167937f1a408571ae6a@o4510971670822912.ingest.us.sentry.io/4510978234712064'
# 발급처 : Sentry 프로젝트 설정의 Client Keys
# 의존성 : apps/api
# 설명 : Sentry api 프로젝트 오류 수집 DSN

# CloudFront

export CLOUDFRONT_DOMAIN_DEV='static.dev.bconnect.to'
# 발급처 : AWS CloudFront 콘솔
# 의존성 : apps/api
# 설명 : 파일 배포 도메인

export CLOUDFRONT_KEY_PAIR_ID_DEV='K255OISTN8MNTB'
# 발급처 : AWS CloudFront 콘솔의 공개 키
# 의존성 : apps/api
# 설명 : 서명 쿠키 검증용 공개 키 ID

export CLOUDFRONT_COOKIE_DOMAIN_DEV='.bconnect.to'
# 발급처 : 수동 작성
# 의존성 : apps/api
# 설명 : CloudFront 서명 쿠키 적용 도메인

# CORS · Cookie

export CORS_ALLOWED_ORIGIN_DEV='https://dev.bconnect.to,https://career.dev.bconnect.to,https://plan.dev.bconnect.to'
# 발급처 : 수동 작성
# 의존성 : apps/api
# 설명 : 허용할 클라이언트 Origin

export CORS_ALLOWED_ORIGIN_PATTERNS_DEV='https://*.vercel.app'
# 발급처 : 수동 작성
# 의존성 : apps/api
# 설명 : 허용할 클라이언트 Origin 패턴

export JWT_COOKIE_DOMAIN_DEV='.bconnect.to'
# 발급처 : 수동 작성
# 의존성 : apps/api
# 설명 : 인증 쿠키 적용 도메인

