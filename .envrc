# 본 파일은 로컬 환경변수의 공개값을 관리합니다.

source_env_if_exists .envrc.local

for envrc in apps/*/.envrc; do
  source_env_if_exists "$envrc"
done

# AWS
export AWS_REGION=ap-northeast-2
# 발급처 : 수동 발급
# 의존성 : AWS CLI · SDK
# 설명 : AWS 기본 리전

# API
export API_URL=http://localhost:8080
# 발급처 : 수동 발급
# 의존성 : @bconnect/api-client
# 설명 : 서버 사이드 API 서버 주소