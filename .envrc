# 본 파일은 공개값을 관리합니다.

source_env_if_exists .envrc.local

# AWS

export AWS_PROFILE=morton-mfa
# 발급처 : 수동 발급
# 설명 : AWS CLI 인증 프로필

export AWS_REGION=ap-northeast-2
# 발급처 : 수동 발급
# 설명 : AWS 기본 리전

# GCP

export CLOUDSDK_CONFIG=$HOME/.config/gcloud
# 발급처 : gcloud auth application-default login
# 의존성 : infra/firebase
# 설명 : gcloud 로컬 인증 설정 경로

# API

export API_URL=http://localhost:8080
# 발급처 : 수동 발급
# 의존성 : @bconnect/api-client
# 설명 : 로컬 API 서버 주소

